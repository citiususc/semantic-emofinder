###  https://www.usc.gal/pcc/app/emofinder/affects
:affects rdf:type owl:ObjectProperty ;
         rdfs:domain :Annotation ;
         rdfs:range :Word ;
         rdfs:label "affects" .


###  https://www.usc.gal/pcc/app/emofinder/article
:article rdf:type owl:ObjectProperty ;
         rdfs:range xsd:String .


###  https://www.usc.gal/pcc/app/emofinder/articleLink
:articleLink rdf:type owl:ObjectProperty ;
             rdfs:range xsd:String .


###  https://www.usc.gal/pcc/app/emofinder/category
:category rdf:type owl:ObjectProperty ;
          rdfs:domain :Word ;
          rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                              owl:hasValue <https://www.usc.gal/pcc/app/emofinder/kos/Category>
                                            ]
                                          ) ;
                       rdf:type owl:Class
                     ] ;
          rdfs:label "category" .


###  https://www.usc.gal/pcc/app/emofinder/extractedFrom
:extractedFrom rdf:type owl:ObjectProperty ;
               rdfs:domain :Annotation ;
               rdfs:range :WordDatabase ;
               rdfs:label "extracted from" .


###  https://www.usc.gal/pcc/app/emofinder/isPublic
:isPublic rdf:type owl:ObjectProperty ;
          rdfs:range xsd:Boolean .


###  https://www.usc.gal/pcc/app/emofinder/mean
:mean rdf:type owl:ObjectProperty ;
